{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectDemoBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::northstar-demo-docs"
    },
    {
      "Sid": "ReadDemoIntake",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::northstar-demo-docs/ap-intake/2026-06/*"
    },
    {
      "Sid": "WriteDemoResults",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::northstar-demo-docs/ap-processed/2026-06/*"
    }
  ]
}
