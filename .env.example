# Optional overrides for local development. Copy this file to `.env` or
# `.env.local` and uncomment the settings you need.
# `npm run dev` supplies safe local defaults and does not consume production
# Firebase, Stripe, GCS, Cloud Tasks, or OpenConnector configuration.

# To opt into a dedicated non-production Google Cloud project for AI features:
# CPAA_LOCAL_GOOGLE_CLOUD_PROJECT_ID=my-development-project

# Tasklytic production integrations (server-only; never NEXT_PUBLIC_*)
# GOOGLE_CLOUD_PROJECT_ID=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
# GCS_BUCKET_NAME=your-private-tasklytic-bucket
# GMAIL_SENDER_ACCOUNT=sender@example.com
# GMAIL_FROM_ALIAS=noreply@example.com
# TASKLYTIC_RECEIPT_MODEL=gemini-2.5-flash
# STRIPE_SECRET_KEY=sk_live_...
# TASKLYTIC_STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Workspace-plan billing intentionally continues to use the separate STRIPE_WEBHOOK_SECRET.
# CPAA_LOCAL_GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/dev-service-account.json

# Backend database connection pool (per Uvicorn worker)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=5
# DB_POOL_RECYCLE_SECONDS=1800

# To opt into a local OpenConnector runtime:
# CPAA_LOCAL_OPENCONNECTOR_URL=http://127.0.0.1:8088
# CPAA_LOCAL_OPENCONNECTOR_RUNTIME_TOKEN=local-runtime-token
# CPAA_LOCAL_OPENCONNECTOR_ADMIN_TOKEN=local-admin-token

# Stripe usage meters
STRIPE_PAGE_METER_EVENT_NAME=cpaautomation_pages
STRIPE_TOKEN_METER_EVENT_NAME=cpaautomation_tokens
STRIPE_PRICE_BASIC_TOKEN_METERED=
STRIPE_PRICE_PRO_TOKEN_METERED=

# Local Google OAuth credentials (optional):
# CPAA_LOCAL_GOOGLE_CLIENT_ID=...
# CPAA_LOCAL_GOOGLE_CLIENT_SECRET=...

# Tasklytic customer persistence always uses the backend repository.
# Browser persistence is restricted to tests and explicitly enabled internal
# evaluation tooling (`NEXT_PUBLIC_INTERNAL_EVAL=true`).

# TaxAtlas native module (shared DATABASE_URL, Firebase, billing, and KMS)
# TAXATLAS_PUBLIC_URL=http://localhost:3000
# TAXATLAS_CRAWLER_ENABLED=true
# TAXATLAS_CRAWLER_NETWORK=true
# TAXATLAS_CRAWLER_TIMEOUT_SECONDS=20
# TAXATLAS_BROWSER_ENABLED=false
# TAXATLAS_BROWSER_TIMEOUT_SECONDS=45
# TAXATLAS_RATE_LIMIT_DEFAULT=120
# TAXATLAS_RATE_LIMIT_ANON=20
# TAXATLAS_REDIS_URL=redis://127.0.0.1:6379/0
# TAXATLAS_SMTP_HOST=
# TAXATLAS_SMTP_PORT=587
# TAXATLAS_SMTP_USER=
# TAXATLAS_SMTP_PASSWORD=
# TAXATLAS_SMTP_FROM=TaxAtlas <no-reply@example.com>
# TAXATLAS_SMTP_STARTTLS=true
# TAXATLAS_WEBHOOK_TIMEOUT_SECONDS=10
# TAXATLAS_NOTIFY_DISPATCH_INTERVAL_SECONDS=60
# TAXATLAS_NOTIFY_MAX_ATTEMPTS=5
# TAXATLAS_TRANSLATE_PROVIDER=none
# TAXATLAS_TRANSLATE_TARGET=en
# TAXATLAS_TRANSLATE_MAX_CHARS=2000
# TAXATLAS_TRANSLATE_DAILY_CHAR_BUDGET=2000000
# TAXATLAS_TRANSLATE_GCP_PROJECT=
# TAXATLAS_TRANSLATE_GCP_LOCATION=global
# TAXATLAS_SEED_VERSION=2026-08-native-v1
# TAXATLAS_CRAWL_JOB=taxatlas-crawl
# TAXATLAS_CRAWL_NEWS_JOB=taxatlas-crawl-news
# TAXATLAS_CRAWL_BROWSER_JOB=taxatlas-crawl-browser
# TAXATLAS_RATES_WATCH_JOB=taxatlas-rates-watch
# Job deployment overrides (scripts/deploy-taxatlas-jobs.sh):
# TAXATLAS_API_IMAGE=REGION-docker.pkg.dev/PROJECT/cpa-docker/backend:TAG
# TAXATLAS_BROWSER_IMAGE=REGION-docker.pkg.dev/PROJECT/cpa-docker/taxatlas-browser:TAG
# TAXATLAS_JOB_SECRETS=DATABASE_URL=DATABASE_URL:latest,ENCRYPTION_KEY=ENCRYPTION_KEY:latest
# VPC_CONNECTOR=cpa-svpc
# KMS_KEY_RESOURCE_NAME=projects/PROJECT/locations/REGION/keyRings/RING/cryptoKeys/KEY
