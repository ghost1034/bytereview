# Copy to .env for docker compose. Never commit .env.
APP_ENV=production
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-at-least-32-random-characters-please
# Public origin(s) of the web app (comma-separated). No localhost in production.
CORS_ORIGINS=https://crm.example.com
WEB_PORT=8080
WEB_CONCURRENCY=2
LOG_FORMAT=json
LOG_LEVEL=INFO
SENTRY_DSN=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
