FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app TAXATLAS_BROWSER_ENABLED=true
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt playwright && playwright install --with-deps chromium
COPY backend/ .
RUN useradd --create-home --shell /bin/bash app && chown -R app:app /app
USER app
ENTRYPOINT ["python", "-m", "taxatlas.jobs"]
CMD ["crawl-browser"]

