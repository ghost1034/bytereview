{
  "name": "financialextract-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "next dev",
    "build": "next build && next-sitemap",
    "check:tasklytic-bundle": "node scripts/check-tasklytic-bundle.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:tasklytic": "node scripts/check-tasklytic-styles.mjs && eslint project-management app/dashboard/project-management app/project-management --max-warnings=101",
    "check:tasklytic-styles": "node scripts/check-tasklytic-styles.mjs",
    "type-check": "tsc --noEmit",
    "sitemap": "next-sitemap",
    "postbuild": "next-sitemap",
    "postinstall": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});const s='node_modules/pdfjs-dist/build/pdf.worker.min.mjs';if(fs.existsSync(s)){fs.copyFileSync(s,'public/pdf-worker.min.mjs')}else{console.warn('postinstall: pdf worker not found at '+s+'; using committed copy')}\"",
    "backend": "cd backend && .venv/bin/python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "generate-types": "cd backend && npm run generate-types",
    "check:openapi": "cd backend && npm run check-openapi",
    "dev:with-types": "npm run generate-types && npm run dev",
    "test:unit": "vitest run",
    "test:tasklytic": "vitest run --config vitest.tasklytic-unit.config.ts",
    "test:tasklytic:browser": "vitest run --config vitest.tasklytic-browser.config.ts",
    "test:tasklytic:backend": "backend/.venv/bin/python -m pytest backend/tests/test_tasklytic_service.py backend/tests/test_tasklytic_psa.py backend/tests/test_tasklytic_billing.py backend/tests/test_tasklytic_integrations.py -q",
    "test:taxatlas": "backend/.venv/bin/python -m pytest backend/tests/test_taxatlas_*.py -q",
    "taxatlas:seed": "cd backend && .venv/bin/python -m taxatlas.jobs seed",
    "taxatlas:crawl": "cd backend && .venv/bin/python -m taxatlas.jobs crawl",
    "taxatlas:dispatch": "cd backend && .venv/bin/python -m taxatlas.jobs dispatch",
    "tasklytic:phases": "node scripts/run-tasklytic-phases.mjs",
    "tasklytic-redesign:phases": "node scripts/run-tasklytic-redesign-phases.mjs"
  },
