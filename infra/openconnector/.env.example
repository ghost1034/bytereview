# OpenConnector runtime environment (lives ONLY on the VM at
# /opt/openconnector/.env — values come from GCP Secret Manager, seeded by
# scripts/setup-openconnector-vm.sh). Never commit real values.

# Public origin used to build provider OAuth redirect URIs. Provider OAuth
# apps must whitelist ${OOMOL_CONNECT_ORIGIN}/oauth/callback.
OOMOL_CONNECT_ORIGIN=https://connect.cpaautomation.ai

# AES-256-GCM key for credentials at rest in connect.sqlite. Rotating it
# requires the runtime's `runtime:data rotate-key` flow — losing it strands
# every stored credential, so it is backed by the OOMOL_CONNECT_ENCRYPTION_KEY
# secret in Secret Manager and nowhere else.
OOMOL_CONNECT_ENCRYPTION_KEY=

# Protects the runtime's /api/* admin surface (OAuth app configs, connection
# upserts, runs). Held by the CPAA backend as OPENCONNECTOR_ADMIN_TOKEN.
OOMOL_CONNECT_ADMIN_TOKEN=

# Bearer token for /v1/* action execution and /mcp. Held by the CPAA backend
# as OPENCONNECTOR_RUNTIME_TOKEN. Never given to browsers or Claw containers.
OOMOL_CONNECT_RUNTIME_TOKEN=

# Optional comma-separated action denylist (wildcards allowed), e.g.
# "github.delete_repository,*.delete_*". Defense-in-depth under the broker.
OOMOL_CONNECT_BLOCKED_ACTIONS=
