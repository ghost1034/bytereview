# Copy to /etc/hosted-claw/worker.env as root (mode 0600) on the pilot VM.
# Every image reference must use @sha256, never a mutable tag.
GOOGLE_CLOUD_PROJECT=your-project
HOSTED_CLAW_API_URL=https://api.example.com
HOSTED_CLAW_INTERNAL_AUDIENCE=https://api.example.com
HOSTED_CLAW_PUBSUB_SUBSCRIPTION=hosted-claw-pilot
HOSTED_CLAW_MAX_TURNS=3
HOSTED_CLAW_MAX_RESIDENT_RUNTIMES=3
HOSTED_CLAW_IDLE_SECONDS=300
HOSTED_CLAW_CRON_ENABLED=true
HOSTED_CLAW_SUPERVISOR_IMAGE=us-central1-docker.pkg.dev/PROJECT/hosted-claw/hosted-supervisor@sha256:REPLACE
HOSTED_ACCOUNTINGCLAW_IMAGE=us-central1-docker.pkg.dev/PROJECT/hosted-claw/hosted-accountingclaw@sha256:REPLACE
HOSTED_LEGALCLAW_IMAGE=us-central1-docker.pkg.dev/PROJECT/hosted-claw/hosted-legalclaw@sha256:REPLACE
HOSTED_CLAW_PROXY_IMAGE=caddy@sha256:REPLACE
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:REPLACE
LITELLM_POSTGRES_IMAGE=postgres@sha256:REPLACE
LITELLM_ADMIN_URL=http://127.0.0.1:4000
LITELLM_TENANT_ORIGIN=http://litellm:4000
LITELLM_MASTER_KEY=REPLACE
LITELLM_DB_PASSWORD=REPLACE
# LiteLLM's Gemini provider uses the gemini/ prefix.
HOSTED_CLAW_DEFAULT_MODEL=gemini/gemini-3.6-flash
HOSTED_CLAW_PROVIDER_API_KEY=REPLACE
