#!/usr/bin/env bash
set -euo pipefail

DATA_DIR="${HERMES_DATA_DIR:-/opt/data}"
BUNDLE_PATH="${ACCOUNTINGCLAW_BUNDLE:-/opt/cpaa/accountingclaw-profile.tar.gz.enc}"
MARKER_FILE="$DATA_DIR/.cpaa/accountingclaw-installed"

mkdir -p "$DATA_DIR/.cpaa" "$DATA_DIR/skills"

if [ ! -s "$MARKER_FILE" ]; then
  if [ -z "${CPAA_BUNDLE_SECRET:-}" ]; then
    echo "AccountingClaw bundle decryption required. Set CPAA_BUNDLE_SECRET to install bundled skills."
    exit 64
  fi

  if [ ! -s "$BUNDLE_PATH" ]; then
    echo "AccountingClaw encrypted bundle not found at $BUNDLE_PATH."
    exit 66
  fi

  if command -v sha256sum >/dev/null 2>&1 && [ -s "${BUNDLE_PATH}.sha256" ]; then
    (
      cd "$(dirname "$BUNDLE_PATH")"
      sha256sum -c "$(basename "${BUNDLE_PATH}.sha256")" >/dev/null
    )
  fi

  tmp_dir="$(mktemp -d)"
  cleanup() {
    rm -rf "$tmp_dir"
  }
  trap cleanup EXIT

  openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -md sha256 \
    -in "$BUNDLE_PATH" \
    -out "$tmp_dir/accountingclaw-profile.tar.gz" \
    -pass env:CPAA_BUNDLE_SECRET

  tar -tzf "$tmp_dir/accountingclaw-profile.tar.gz" >/dev/null
  tar -xzf "$tmp_dir/accountingclaw-profile.tar.gz" -C "$DATA_DIR"

  date -u +%Y-%m-%dT%H:%M:%SZ > "$MARKER_FILE"
fi

if [ -x /opt/hermes/docker/entrypoint.sh ]; then
  exec /opt/hermes/docker/entrypoint.sh "$@"
fi

if [ -x /opt/hermes/.venv/bin/hermes ]; then
  exec /opt/hermes/.venv/bin/hermes "$@"
fi

if command -v hermes >/dev/null 2>&1; then
  exec hermes "$@"
fi

exec "$@"
